<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>M28 scheduler launch (preflight wrapped)</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger><Enabled>true</Enabled></LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Trading_Agent_System\venv\Scripts\python.exe</Command>
      <Arguments>scripts/launch_with_preflight.py --role scheduler --profile dev --env-path .env -- python scripts/run_commander_runtime_once.py --live --json</Arguments>
      <WorkingDirectory>C:\Trading_Agent_System</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
