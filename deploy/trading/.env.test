# Mock Trading Runtime Docker validation -- TEST-ONLY env file.
# No real credentials. Never used for real trading. Mirrors
# config/.env.example, scoped down for isolated mock validation.
#
# Hard mock safety is enforced primarily via compose.trading.yaml's
# `environment:` block (real process env, set before this file is even
# read -- libs/core/settings.py::load_env_file only fills keys NOT already
# present in os.environ, so compose's values always win). This file exists
# as defense-in-depth / documentation of the full expected key set, not as
# the primary safety boundary.

RUNTIME_PROFILE=dev
KIWOOM_MODE=mock
EXECUTION_MODE=mock
DRY_RUN=1
LOG_LEVEL=INFO

EXECUTION_ENABLED=false
APPROVAL_MODE=manual
ALLOW_REAL_EXECUTION=false

SYMBOL_ALLOWLIST=
MAX_ORDER_QTY=0
MAX_ORDER_NOTIONAL=0
RISK_DAILY_LOSS_LIMIT=0.0
RISK_MAX_POSITIONS=1

UNIVERSE_SYMBOLS=005930
KIWOOM_CANDIDATE_ENABLE_CONDITION_SEARCH=false
FALLBACK_CANDIDATE_SYMBOLS=

KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NO=
KIWOOM_BASE_URL_MOCK=https://mockapi.kiwoom.com
KIWOOM_BASE_URL_REAL=https://api.kiwoom.com

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=

AI_STRATEGIST_API_KEY=
AI_STRATEGIST_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
