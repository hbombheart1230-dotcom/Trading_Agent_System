# Real Trading Runtime -- TEMPLATE only, no real credentials. Copy this to
# a local, gitignored `.env.real` (see .gitignore: `deploy/trading/.env.real`)
# and fill in real values ONLY as part of a separate, explicitly-approved
# "REAL EXECUTION CHANGE WINDOW" phase -- never as part of standing up this
# Docker deployment for the first time.
#
# EXECUTION_ENABLED and ALLOW_REAL_EXECUTION are DELIBERATELY ABSENT from
# this template: they are hardcoded "false" as LITERAL values directly in
# compose.trading.real.yaml's own `environment:` block, specifically so
# nothing in this file (or any env file) can ever set them true. See that
# file's header comment for the full reasoning. Do not add them here.

RUNTIME_PROFILE=prod
KIWOOM_MODE=mock
EXECUTION_MODE=real
DRY_RUN=0
LOG_LEVEL=INFO

APPROVAL_MODE=manual

SYMBOL_ALLOWLIST=
MAX_ORDER_QTY=0
MAX_ORDER_NOTIONAL=0
RISK_DAILY_LOSS_LIMIT=0.0
RISK_MAX_POSITIONS=1

UNIVERSE_SYMBOLS=005930
KIWOOM_CANDIDATE_ENABLE_CONDITION_SEARCH=false
FALLBACK_CANDIDATE_SYMBOLS=

# Real broker credentials -- leave blank until the REAL EXECUTION CHANGE
# WINDOW phase. RealExecutor.preflight_check() requires these ONLY after
# EXECUTION_ENABLED/ALLOW_REAL_EXECUTION both pass, which this deployment's
# compose file makes structurally impossible right now -- but leave them
# blank anyway; there is no reason to stage real secrets on disk before
# they are needed.
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NO=
KIWOOM_BASE_URL_MOCK=https://mockapi.kiwoom.com
KIWOOM_BASE_URL_REAL=https://api.kiwoom.com

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=

AI_STRATEGIST_API_KEY=
AI_STRATEGIST_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
