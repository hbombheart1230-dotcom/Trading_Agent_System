# Trading Agent System - Canonical Environment Template
# Copy this file to project root as `.env` and fill required secrets.
#
# Policy:
# - This is the single source of truth for env keys.
# - `config/env_example` and `config/env_example.m19_4_additions` are compatibility pointers.

# --------------------------------------------------------------------
# Core Runtime
# --------------------------------------------------------------------
RUNTIME_PROFILE=dev
KIWOOM_MODE=mock
EXECUTION_MODE=mock
DRY_RUN=1
LOG_LEVEL=INFO

# Execution control
EXECUTION_ENABLED=false
APPROVAL_MODE=manual
ALLOW_REAL_EXECUTION=false

# --------------------------------------------------------------------
# Safety and Risk
# --------------------------------------------------------------------
# Optional safety guard:
# - Empty/unset: no symbol restriction (default architecture).
# - Set values: only listed symbols are executable.
SYMBOL_ALLOWLIST=
MAX_ORDER_QTY=0
MAX_ORDER_NOTIONAL=0
RISK_DAILY_LOSS_LIMIT=0.0
RISK_PER_TRADE_LOSS_LIMIT=0.0
RISK_MAX_POSITIONS=1
RISK_ORDER_COOLDOWN_SEC=0
# PORTFOLIO_SNAPSHOT_HEALTH_GUARD_ENABLED=true
# USE_EOD_FORCE_LIQUIDATION=false
# EOD_FORCE_LIQUIDATION_START_HHMM=1520
# EOD_FORCE_LIQUIDATION_END_HHMM=1530
# USE_EXIT_POLICY=false
# EXIT_POLICY_STOP_LOSS_PCT=0.03
# EXIT_POLICY_TAKE_PROFIT_PCT=0.05
# EXIT_POLICY_MAX_HOLD_SEC=0
# MIN_HOLD_SECONDS=600
# Normal SELL exits are blocked until this hold time elapses after entry.
# SELL_COOLDOWN=300
# SELL_COOLDOWN_SEC=300
# Sell cooldown suppresses repeated SELL intent emission across polling loops.
# MONITOR_EXIT_CONFIRM_TICKS=2
# Exit signal must be observed for N consecutive monitor checks before SELL.
# EXIT_POLICY_TRAILING_STOP_PCT=0.0
# EXIT_POLICY_VOL_EXPANSION_RATIO=0.0
# USE_POSITION_SIZING=false
# RISK_PER_TRADE_RATIO=0.01
# POSITION_NOTIONAL_RATIO=0.10

# --------------------------------------------------------------------
# Runtime Lifecycle / Preflight (M28)
# --------------------------------------------------------------------
# M28_PROFILE_STRICT=false
# M28_LIFECYCLE_STATE_PATH=data/state/m28_runtime_lifecycle.json
# M28_LIFECYCLE_LOCK_STALE_SEC=1800

# --------------------------------------------------------------------
# Core Paths
# --------------------------------------------------------------------
# EVENT_LOG_PATH=data/logs/events.jsonl
# REPORT_DIR=reports
# STATE_STORE_PATH=data/state.json
# KIWOOM_API_CATALOG_PATH=data/specs/api_catalog.jsonl
# M13_LIVE_LOCK_PATH=data/state/m13_live_loop.lock
# M13_LIVE_LOCK_STALE_SEC=1800
# M13_TICK_PIPELINE=legacy_m10   # legacy_m10 | integrated_chain
# Scanner candidate source
CANDIDATE_SOURCE=kiwoom          # kiwoom | strategist | auto
TOP_CANDIDATE_POOL=30
KIWOOM_CANDIDATE_CONDITION_LIMIT=200
KIWOOM_CANDIDATE_INCLUDE_CHANGE_RATE=true
KIWOOM_CANDIDATE_LIVE_FETCH=false
# If true, scanner blocks pure static strategist fallback when Kiwoom pool is empty.
BLOCK_STATIC_FALLBACK_WHEN_KIWOOM_EMPTY=true
# If true, scanner uses Kiwoom candidates only and blocks all strategist fallback on Kiwoom-empty.
STRICT_KIWOOM_CANDIDATES_ONLY=false
# Optional comma-separated fallback symbols (used by strategist/universe fallback path).
# If empty, runtime uses watchlist/operator symbols only; no built-in static symbol defaults.
FALLBACK_CANDIDATE_SYMBOLS=
# Candidate pool reduction
MIN_TRADING_VALUE=0
MIN_VOLUME=0
ENABLE_THEME_FILTER=true
EXCLUDE_HALTED_STOCKS=true
# Scanner practical scoring weights
SCORE_WEIGHTS_TRADING_VALUE=0.20
SCORE_WEIGHTS_MOMENTUM=0.22
SCORE_WEIGHTS_TREND=0.20
SCORE_WEIGHTS_VOLUME_SURGE=0.14
SCORE_WEIGHTS_INTRADAY_STRENGTH=0.12
SCORE_WEIGHTS_THEME_BOOST=0.06
SCORE_WEIGHTS_SENTIMENT=0.06
SCORE_WEIGHTS_VOLATILITY_PENALTY=0.10
SCORE_WEIGHTS_GAP_PENALTY=0.07
SCORE_WEIGHTS_OPEN_ORDER_PENALTY=0.04
# M10_USE_GLOBAL_SENTIMENT=true
# M10_USE_NEWS_SENTIMENT=true
# M10_DECISION_CONTEXT_REFRESH_SEC=300
# M10_NEWS_PROVIDER=naver
# M10_NEWS_SCORER=simple
# M10_SYMBOL_QUERY_MAP=005930=?쇱꽦?꾩옄,000660=SK?섏씠?됱뒪
# M10_FEATURE_SEED_WITH_YF=true
# M10_FEATURE_SEED_PERIOD=3mo
# M10_FEATURE_SEED_INTERVAL=1d
# M10_FEATURE_SERIES_MAX_ROWS=240
# M10_SYMBOL_YF_MAP=005930=005930.KS,000660=000660.KS

# --------------------------------------------------------------------
# Kiwoom Credentials and Endpoints
# --------------------------------------------------------------------
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NO=
KIWOOM_BASE_URL_MOCK=https://mockapi.kiwoom.com
KIWOOM_BASE_URL_REAL=https://api.kiwoom.com
# KIWOOM_TOKEN_CACHE_PATH=data/token_cache.json
# KIWOOM_TOKEN_REFRESH_MARGIN_SEC=300
# KIWOOM_HTTP_TIMEOUT_SEC=10
# KIWOOM_RETRY_MAX=2
# KIWOOM_PAGINATION_MAX_CALLS=10

# --------------------------------------------------------------------
# OpenRouter (shared LLM base settings)
# --------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_DEFAULT_TEMPERATURE=0.2
OPENROUTER_DEFAULT_MAX_TOKENS=256
# OPENROUTER_MODEL_STRATEGIST=anthropic/claude-3.5-sonnet
# OPENROUTER_MODEL_SCANNER=openai/gpt-5-nano
# OPENROUTER_MODEL_REPORTER=google/gemini-2.5-flash-lite
# REPORTER_AI_REVIEW_ENABLED=false
# REPORTER_AI_REVIEW_MODEL=
# REPORTER_AI_REVIEW_TEMPERATURE=0.1
# REPORTER_AI_REVIEW_MAX_TOKENS=900
# OPENROUTER_TIMEOUT_SEC=15
# OPENROUTER_HTTP_REFERER=https://your-domain-or-repo
# OPENROUTER_X_TITLE=Trading_Agent_System

# --------------------------------------------------------------------
# Strategist LLM Provider (M20)
# --------------------------------------------------------------------
# rule: deterministic local rules
# openai: OpenAI-compatible HTTP (OpenRouter endpoint supported)
AI_STRATEGIST_PROVIDER=rule

# API key priority:
# 1) AI_STRATEGIST_API_KEY
# 2) OPENROUTER_API_KEY (fallback)
AI_STRATEGIST_API_KEY=
AI_STRATEGIST_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
AI_STRATEGIST_MODEL=openai/gpt-4o-mini
AI_STRATEGIST_TIMEOUT_SEC=15
AI_STRATEGIST_MAX_TOKENS=256
AI_STRATEGIST_RETRY_MAX=1
AI_STRATEGIST_RETRY_BACKOFF_SEC=0.5
AI_STRATEGIST_PROMPT_VERSION=m20-6
AI_STRATEGIST_SCHEMA_VERSION=intent.v1
AI_STRATEGIST_PROMPT_COST_PER_1K_USD=0
AI_STRATEGIST_COMPLETION_COST_PER_1K_USD=0
AI_STRATEGIST_JSON_RESPONSE_FORMAT=true
# Strategist frame LLM (Strategist node -> scanner/monitor guidance, not order execution)
# - unset: auto-enable when AI_STRATEGIST_PROVIDER=openai and API key exists
# - true/false: force on/off
# STRATEGIST_FRAME_USE_LLM=true
# STRATEGIST_FRAME_LLM_MODEL=openai/gpt-4o-mini
# STRATEGIST_FRAME_LLM_TEMPERATURE=0.1
# STRATEGIST_FRAME_LLM_MAX_TOKENS=900
# STRATEGIST_FRAME_LLM_PROMPT_VERSION=m31-strategic-frame-v1
# AI_STRATEGIST_BUY_THRESHOLD=0.10
# AI_STRATEGIST_SELL_THRESHOLD=-0.10
# AI_STRATEGIST_HIGH_VOL_ABS_THRESHOLD=0.12
# AI_STRATEGIST_NEWS_BUY_THRESHOLD=0.15
# AI_STRATEGIST_NEWS_SELL_THRESHOLD=-0.15
# AI_STRATEGIST_SCORE_OVERRIDE=false

# --------------------------------------------------------------------
# Strategy V1 (Deterministic strategy layer)
# --------------------------------------------------------------------
# USE_STRATEGY_V1=false
# STRATEGY_V1_NAME=regime_momentum_v1  # regime_momentum_v1|mean_reversion_v1|news_momentum_v1|auto
# STRATEGY_V1_BUY_COMPOSITE_THRESHOLD=0.02
# STRATEGY_V1_SELL_COMPOSITE_THRESHOLD=-0.10
# STRATEGY_V1_MIN_SIGNAL_FOR_ENTRY=0.05
# STRATEGY_V1_MIN_NEWS_FOR_ENTRY=-0.20
# STRATEGY_V1_MAX_VOLATILITY_FOR_ENTRY=0.12
# STRATEGY_V1_INVALIDATION_SIGNAL_FLOOR=-0.12
# STRATEGY_V1_BASE_RISK_PER_TRADE_RATIO=0.01
# STRATEGY_V1_BASE_POSITION_NOTIONAL_RATIO=0.10
# STRATEGY_V1_MIN_CONFIDENCE_FOR_ENTRY=0.35
# STRATEGY_V1_MAX_POSITION_QTY=10
# STRATEGY_V1_MIN_POSITION_QTY=1
# STRATEGY_V1_LOT_SIZE=1
# STRATEGY_V1_MR_BUY_RSI_CEILING=35
# STRATEGY_V1_MR_SELL_RSI_FLOOR=62
# STRATEGY_V1_MR_MIN_GAP_FOR_ENTRY=-0.015
# STRATEGY_V1_MR_MAX_VOLATILITY_FOR_ENTRY=0.15
# STRATEGY_V1_NEWS_BUY_THRESHOLD=0.30
# STRATEGY_V1_NEWS_SELL_THRESHOLD=-0.20
# STRATEGY_V1_NEWS_REQUIRE_OK_STATUS=true
# USE_UNIVERSE_BUILDER=true
# TOP_N_CANDIDATES=10   # optional hard cap; if unset scanner uses TOP_CANDIDATE_POOL
# UNIVERSE_REQUIRE_CONDITION=false

# --------------------------------------------------------------------
# News Provider (M19)
# --------------------------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# SYMBOL_QUERY_MAP_JSON={"005930":"?쇱꽦?꾩옄","000660":"SK?섏씠?됱뒪"}

# --------------------------------------------------------------------
# Alert Policy (M25)
# --------------------------------------------------------------------
# ALERT_POLICY_FAIL_ON=critical
# ALERT_POLICY_LLM_SUCCESS_RATE_MIN=0.70
# ALERT_POLICY_LLM_CIRCUIT_OPEN_RATE_MAX=0.30
# ALERT_POLICY_EXECUTION_BLOCKED_RATE_MAX=0.60
# ALERT_POLICY_EXECUTION_APPROVED_EXECUTED_GAP_MAX=0
# ALERT_POLICY_API_429_RATE_MAX=0.20
# ALERT_POLICY_PORTFOLIO_GUARD_BLOCKED_RATIO_MAX=0.70
# ALERT_POLICY_PORTFOLIO_GUARD_STRATEGY_BUDGET_EXCEEDED_MAX=20

# --------------------------------------------------------------------
# M25 Ops Batch and Notification
# --------------------------------------------------------------------
# M25_BATCH_EVENT_LOG_PATH=data/logs/m25_ops_batch_events.jsonl
# M25_BATCH_REPORT_DIR=reports/m25_ops_batch
# M25_BATCH_LOCK_PATH=data/state/m25_ops_batch.lock
# M25_BATCH_LOCK_STALE_SEC=1800
# M25_BATCH_STATUS_JSON_PATH=reports/m25_ops_batch/status_latest.json
# M25_NOTIFY_EVENT_LOG_PATH=data/logs/m25_notify_events.jsonl

# M25_NOTIFY_PROVIDER=none
# M25_NOTIFY_ON=failure
# M25_NOTIFY_WEBHOOK_URL=
# M25_NOTIFY_PORTFOLIO_GUARD_ESCALATION_MIN=0
# M25_NOTIFY_PORTFOLIO_GUARD_PROVIDER=none
# M25_NOTIFY_PORTFOLIO_GUARD_WEBHOOK_URL=
# M25_NOTIFY_TIMEOUT_SEC=5
# M25_NOTIFY_STATE_PATH=data/state/m25_notify_state.json
# M25_NOTIFY_DEDUP_WINDOW_SEC=600
# M25_NOTIFY_RATE_LIMIT_WINDOW_SEC=600
# M25_NOTIFY_MAX_PER_WINDOW=3
# M25_NOTIFY_RETRY_MAX=1
# M25_NOTIFY_RETRY_BACKOFF_SEC=0.5
# M25_NOTIFY_DRY_RUN=false
# M25_NOTIFY_FAIL_ON_ERROR=false
USE_STRATEGY_V1=false
STRATEGY_V1_NAME=regime_momentum_v1
AI_STRATEGIST_BUY_THRESHOLD=0.10
AI_STRATEGIST_SELL_THRESHOLD=-0.10
AI_STRATEGIST_HIGH_VOL_ABS_THRESHOLD=0.12
AI_STRATEGIST_NEWS_BUY_THRESHOLD=0.15
AI_STRATEGIST_NEWS_SELL_THRESHOLD=-0.15
AI_STRATEGIST_SCORE_OVERRIDE=false
USE_EXIT_POLICY=false
EXIT_POLICY_STOP_LOSS_PCT=0.03
EXIT_POLICY_TAKE_PROFIT_PCT=0.05
EXIT_POLICY_MAX_HOLD_SEC=0
POST_EXIT_COOLDOWN_SEC=300
OPENROUTER_MODEL_SCANNER=
OPENROUTER_MODEL_REPORTER=
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=
